{
  "name": "dialogos",
  "version": "0.1.0",
  "private": true,
  "description": "근거 없이는 물러서지 않는 한국어 토론 상대와, 그 차이를 재는 판정 실험",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p app/web",
    "test": "tsx --test eval/tests/*.test.ts app/tests/*.test.ts .claude/hooks/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "app:dev": "tsx app/dev.ts",
    "app:build": "vite build --config app/web/vite.config.ts",
    "eval:run": "tsx --env-file-if-exists=.env eval/src/run.ts",
    "eval:label": "tsx --env-file-if-exists=.env eval/src/label.ts",
    "eval:score": "tsx eval/src/score.ts",
    "eval:sample": "tsx eval/src/sample.ts",
    "eval:agreement": "tsx eval/src/agreement.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
