# 이 파일에는 변수 이름만 둡니다. 값은 로컬의 .env 파일에만 적습니다.
# .env는 .gitignore에 들어 있어 커밋되지 않습니다.

# 기본 연결 정보 (OpenAI 호환 방식의 chat completions 주소)
LLM_BASE_URL=
LLM_API_KEY=

# 역할별 모델 이름 (제공사 문서에 적힌 이름을 그대로 적습니다)
OPPONENT_MODEL=
JUDGE_MODEL=
SCORER_MODEL=

# 역할별 temperature. 적었을 때만 보냅니다. 비워 두면 보내지 않고 모델 기본값을 씁니다.
# Gemini 3.6 이후 모델은 temperature를 무시하고, 앞으로는 보내면 오류를 낸다고 예고했습니다.
OPPONENT_TEMPERATURE=
JUDGE_TEMPERATURE=
SCORER_TEMPERATURE=

# 역할별 생각(thinking) 수준. reasoning_effort로 보냅니다(예: low, medium, high). 비워 두면 모델 기본값입니다.
# 모델마다 받는 값이 다릅니다. 제공사 문서에서 확인해 적습니다.
OPPONENT_REASONING_EFFORT=
JUDGE_REASONING_EFFORT=
SCORER_REASONING_EFFORT=

# 역할마다 다른 제공사를 쓸 때만 채웁니다. 비워 두면 위의 기본값을 씁니다.
OPPONENT_BASE_URL=
OPPONENT_API_KEY=
JUDGE_BASE_URL=
JUDGE_API_KEY=
SCORER_BASE_URL=
SCORER_API_KEY=
